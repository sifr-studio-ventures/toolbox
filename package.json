{
  "name": "open-toolbox",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "wrangler types && tsc --noEmit",
    "deploy": "npm run build && wrangler d1 migrations apply toolbox --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply toolbox --local",
    "db:migrate": "wrangler d1 migrations apply toolbox --remote",
    "db:migrate:preview": "wrangler d1 migrations apply toolbox-preview --remote --config wrangler.preview-migrations.jsonc",
    "preview": "wrangler preview",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "daisyui": "^5.7.46",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wrangler": "^4.142.0"
  }
}
